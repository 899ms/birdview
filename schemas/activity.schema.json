{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:birdview:activity:1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "mapId", "mapRevision", "sessionId", "taskId", "sequence", "phase", "scope", "targets", "reason", "files", "unmappedFiles", "evidenceKind", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "$ref": "urn:birdview:architecture:1#/$defs/id" },
    "mapId": { "$ref": "urn:birdview:architecture:1#/$defs/id" },
    "mapRevision": { "type": "integer", "minimum": 1 },
    "sessionId": { "$ref": "urn:birdview:architecture:1#/$defs/id" },
    "taskId": { "$ref": "urn:birdview:architecture:1#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["planned", "editing", "verifying", "completed", "failed", "cancelled"] },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:birdview:architecture:1#/$defs/id" } },
    "targets": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:birdview:architecture:1#/$defs/id" } },
    "reason": { "$ref": "urn:birdview:architecture:1#/$defs/text" },
    "files": { "$ref": "#/$defs/paths" }, "unmappedFiles": { "$ref": "#/$defs/paths" },
    "evidenceKind": { "const": "agent-declared" },
    "checks": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["command", "status", "exitCode", "summary"],
      "properties": {
        "command": { "$ref": "urn:birdview:architecture:1#/$defs/text" },
        "status": { "enum": ["passed", "failed", "not-run"] },
        "exitCode": { "type": ["integer", "null"] }, "summary": { "$ref": "urn:birdview:architecture:1#/$defs/text" }
      }
    } }
  },
  "$defs": { "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:birdview:architecture:1#/$defs/path" } } }
}
